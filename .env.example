# =============================================================================
# DRINK WATER API (PHOENIX) - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and adjust values as needed.
# Docker Compose loads .env automatically from the project root.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose.yml)
# -----------------------------------------------------------------------------
POSTGRES_VERSION=17-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=drink_water_dev
POSTGRES_PORT=5432
POSTGRES_MEMORY_LIMIT=512M
POSTGRES_CPU_LIMIT=0.5

# -----------------------------------------------------------------------------
# Production (config/runtime.exs) — uncomment when deploying
# -----------------------------------------------------------------------------
# DATABASE_URL=ecto://USER:PASS@HOST/DATABASE
# POOL_SIZE=10
# SECRET_KEY_BASE=generate_with_mix_phx.gen.secret
# PHX_HOST=example.com
# PHX_SERVER=true
# PORT=4000

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
