### Variables
# After running: mix ecto.reset && mix run priv/repo/seeds.exs
# Seeds truncate tables and reset sequences — IDs always start from 1.
# Seed data: John Doe (id=1), alarm_settings (goal=2000, interval=60min,
#   start=08:00, end=20:00), 5 water intakes on 2024-08-14.
@baseUrl = http://localhost:4000/api
@johnId = 1

###############################################################################
# User CRUD
###############################################################################

### Show John
GET {{baseUrl}}/users/{{johnId}}

### Update John (partial — only changed fields required)
PUT {{baseUrl}}/users/{{johnId}}
Content-Type: application/json

{
  "user": {
    "weight": 72.0
  }
}

### Update John (full — all fields)
PUT {{baseUrl}}/users/{{johnId}}
Content-Type: application/json

{
  "user": {
    "email": "john.doe@test.com",
    "first_name": "John",
    "last_name": "Doe",
    "birth_date": "1990-01-01",
    "biological_sex": "male",
    "weight": 70.5,
    "weight_unit": "kg",
    "height": 175.0,
    "height_unit": "cm"
  }
}

### Delete John (cascade: deletes alarm_settings + water_intakes)
# Idempotent — returns 204 even if user does not exist.
DELETE {{baseUrl}}/users/{{johnId}}

###############################################################################
# Alarm Settings CRUD
###############################################################################

### Show John's alarm settings
GET {{baseUrl}}/users/{{johnId}}/alarm_settings

### Update John's alarm settings (partial)
PUT {{baseUrl}}/users/{{johnId}}/alarm_settings
Content-Type: application/json

{
  "alarm_settings": {
    "goal": 2500,
    "interval_minutes": 45
  }
}

### Update John's alarm settings (full)
PUT {{baseUrl}}/users/{{johnId}}/alarm_settings
Content-Type: application/json

{
  "alarm_settings": {
    "goal": 3000,
    "interval_minutes": 30,
    "daily_start_time": "07:00:00",
    "daily_end_time": "21:00:00"
  }
}

### Delete John's alarm settings
DELETE {{baseUrl}}/users/{{johnId}}/alarm_settings

### Recreate John's alarm settings (after delete)
POST {{baseUrl}}/users/{{johnId}}/alarm_settings
Content-Type: application/json

{
  "alarm_settings": {
    "goal": 2000,
    "interval_minutes": 60,
    "daily_start_time": "08:00:00",
    "daily_end_time": "20:00:00"
  }
}

###############################################################################
# Water Intakes CRUD
###############################################################################

### List John's intakes (seed data — start_date and end_date required, UTC)
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z

### Get a specific intake
GET {{baseUrl}}/users/{{johnId}}/water_intakes/1

### Create intake (use current UTC timestamp for LiveView real-time test)
POST {{baseUrl}}/users/{{johnId}}/water_intakes
Content-Type: application/json

{
  "water_intake": {
    "date_time_utc": "2026-03-18T00:58:00Z",
    "volume": 550,
    "volume_unit": "ml"
  }
}

### Update intake (partial — only changed fields)
PUT {{baseUrl}}/users/{{johnId}}/water_intakes/1
Content-Type: application/json

{
  "water_intake": {
    "volume": 500
  }
}

### Delete intake
DELETE {{baseUrl}}/users/{{johnId}}/water_intakes/1

###############################################################################
# Water Intakes — Filtering
###############################################################################

### Filter by volume range (only 200-350ml)
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&min_volume=200&max_volume=350

### Filter by minimum volume only
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&min_volume=400

### Filter by maximum volume only
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&max_volume=300

###############################################################################
# Water Intakes — Sorting
# sort_field: date_time_utc (default) | volume | id
# sort_direction: desc (default) | asc
###############################################################################

### Sort by volume ascending
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&sort_field=volume&sort_direction=asc

### Sort by date ascending (oldest first)
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&sort_field=date_time_utc&sort_direction=asc

### Sort by volume descending
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&sort_field=volume&sort_direction=desc

###############################################################################
# Water Intakes — Cursor-based Pagination
###############################################################################

### First page (2 per page)
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&size=2

### Next page (replace cursor with next_cursor from response above)
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&size=2&cursor=REPLACE_WITH_CURSOR

### Sort + pagination combined
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&sort_field=volume&sort_direction=desc&size=2

###############################################################################
# Error Catalog (RFC 7807 Problem Details)
# All errors return application/problem+json with type, title, status, detail.
# Run seeds first: mix ecto.reset && mix run priv/repo/seeds.exs
###############################################################################

# --- 400 Bad Request ---

### 400 — Malformed JSON (parsing-error)
POST {{baseUrl}}/users
Content-Type: application/json

{this is not valid json}

### 400 — Invalid cursor (invalid-argument)
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&cursor=not-a-valid-cursor

# --- 404 Not Found ---

### 404 — User not found (user-not-found)
GET {{baseUrl}}/users/999

### 404 — Alarm settings not found (alarm-settings-not-found)
# Requires deleting John's alarm settings first.
GET {{baseUrl}}/users/{{johnId}}/alarm_settings

### 404 — Water intake not found (waterintake-not-found)
GET {{baseUrl}}/users/{{johnId}}/water_intakes/999

# --- 409 Conflict ---

### 409 — Duplicate email (user-already-exists)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "user": {
    "email": "john.doe@test.com",
    "first_name": "Duplicate",
    "last_name": "John",
    "birth_date": "1990-01-01",
    "biological_sex": "male",
    "weight": 70.0,
    "weight_unit": "kg",
    "height": 175.0,
    "height_unit": "cm"
  }
}

### 409 — Alarm settings already exist (alarm-settings-already-exists)
POST {{baseUrl}}/users/{{johnId}}/alarm_settings
Content-Type: application/json

{
  "alarm_settings": {
    "goal": 3000,
    "interval_minutes": 30,
    "daily_start_time": "07:00:00",
    "daily_end_time": "21:00:00"
  }
}

### 409 — Duplicate datetime (waterintake-duplicate-datetime)
# John already has a record at 2024-08-14T10:00:00Z from seeds.
POST {{baseUrl}}/users/{{johnId}}/water_intakes
Content-Type: application/json

{
  "water_intake": {
    "date_time_utc": "2024-08-14T10:00:00Z",
    "volume": 500,
    "volume_unit": "ml"
  }
}

# --- 422 Unprocessable Entity ---

### 422 — Missing required fields (validation-error)
POST {{baseUrl}}/users
Content-Type: application/json

{
  "user": {
    "email": ""
  }
}

### 422 — Name with numbers (validation-error)
PUT {{baseUrl}}/users/{{johnId}}
Content-Type: application/json

{
  "user": {
    "first_name": "John123"
  }
}

### 422 — Name with XSS attempt (validation-error)
PUT {{baseUrl}}/users/{{johnId}}
Content-Type: application/json

{
  "user": {
    "last_name": "Doe<script>"
  }
}

### 422 — Invalid sort_field
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&sort_field=email

### 422 — Invalid sort_direction
GET {{baseUrl}}/users/{{johnId}}/water_intakes?start_date=2024-08-14T00:00:00Z&end_date=2024-08-14T23:59:59Z&sort_direction=sideways

### 422 — Alarm settings validation (goal out of range)
PUT {{baseUrl}}/users/{{johnId}}/alarm_settings
Content-Type: application/json

{
  "alarm_settings": {
    "goal": 5,
    "interval_minutes": 999
  }
}

### 422 — Water intake validation (volume out of range)
POST {{baseUrl}}/users/{{johnId}}/water_intakes
Content-Type: application/json

{
  "water_intake": {
    "date_time_utc": "2026-03-18T12:00:00Z",
    "volume": 99999,
    "volume_unit": "ml"
  }
}

# --- 204 No Content (Idempotent Delete) ---

### 204 — Delete nonexistent user (no error)
DELETE {{baseUrl}}/users/999

### 204 — Delete with non-numeric ID (no error)
DELETE {{baseUrl}}/users/abc
